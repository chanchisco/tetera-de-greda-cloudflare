{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tetera-de-greda-cf",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "keep_vars": true
}
